#!/usr/bin/env python3
"""
Streamlit Web Interface for PDF to Audiobook Converter
Upload PDF files, convert to audiobook, and download the result
"""

import streamlit as st
import os
import tempfile
from pathlib import Path
from pdf_to_audiobook import PDFToAudiobook
import time

# Page configuration
st.set_page_config(
    page_title="PDF to Audiobook Converter",
    page_icon="�",
    layout="centered",
    initial_sidebar_state="expanded"
)

# Custom CSS for better styling
st.markdown("""
    <style>
    .main-header {
        text-align: center;
        color: #1E88E5;
        font-size: 2.5em;
        font-weight: bold;
        margin-bottom: 0.5em;
    }
    .sub-header {
        text-align: center;
        color: #666;
        font-size: 1.2em;
        margin-bottom: 2em;
    }
    .stButton>button {
        width: 100%;
        background-color: #4CAF50;
        color: white;
        font-size: 18px;
        font-weight: bold;
        padding: 12px;
        border-radius: 8px;
        border: none;
        margin-top: 10px;
    }
    .stButton>button:hover {
        background-color: #45a049;
    }
    .success-box {
        padding: 20px;
        border-radius: 10px;
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
        margin: 20px 0;
    }
    .info-box {
        padding: 15px;
        border-radius: 8px;
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
        margin: 15px 0;
    }
    .warning-box {
        padding: 15px;
        border-radius: 8px;
        background-color: #fff3cd;
        border: 1px solid #ffeaa7;
        color: #856404;
        margin: 15px 0;
    }
    </style>
""", unsafe_allow_html=True)

# Header
st.markdown('<div class="main-header">PDF to Audiobook Converter</div>', unsafe_allow_html=True)
st.markdown('<div class="sub-header">Transform your PDF documents into high-quality audiobooks</div>', unsafe_allow_html=True)

# Sidebar for settings
with st.sidebar:
    st.header("Settings")
    
    # Language selection
    st.subheader("Language")
    language_option = st.selectbox(
        "Choose Language:",
        ["English (US)", "Bengali (বাংলা)"],
        index=0
    )
    
    # Map language selection to codes
    if language_option == "Bengali (বাংলা)":
        language = "bn"
        voice = "bn-BD-NabanitaNeural"
        st.success("Bengali voice: Nabanita (Female)")
    else:
        language = "en"
        voice = "en-US-AriaNeural"
        st.success("English voice: Aria (Female)")
    
    # Engine selection - Only Edge TTS
    engine = "edge"
    
    st.info("Microsoft Edge TTS - High quality neural voices with no rate limits")
    
    st.markdown("---")
    
    # About section
    st.header("About")
    st.write("""
    This tool converts PDF documents into audiobooks using advanced text-to-speech technology.
    
    **Features:**
    - High-quality neural voices
    - English & Bengali support
    - No rate limits
    - Easy drag-and-drop interface
    - Preview before download
    """)
    
    st.markdown("---")
    st.caption("AK Junaid")

# Main content area
st.markdown("### Upload Your PDF")

# File uploader with drag and drop
uploaded_file = st.file_uploader(
    "Drag and drop your PDF file here or click to browse",
    type=['pdf'],
    help="Upload a PDF file to convert to audiobook"
)

# Display file info if uploaded
if uploaded_file is not None:
    st.markdown('<div class="info-box">', unsafe_allow_html=True)
    col1, col2 = st.columns([2, 1])
    with col1:
        st.write(f"**Filename:** {uploaded_file.name}")
        st.write(f"**File size:** {uploaded_file.size / 1024:.2f} KB")
    with col2:
        st.success("File loaded")
    st.markdown('</div>', unsafe_allow_html=True)
    
    # Save PDF to temp location for processing
    temp_pdf_path = None
    with tempfile.NamedTemporaryFile(delete=False, suffix='.pdf') as tmp_file:
        tmp_file.write(uploaded_file.getbuffer())
        temp_pdf_path = tmp_file.name
    
    # Quick analysis of PDF to get page count
    try:
        import PyPDF2
        with open(temp_pdf_path, 'rb') as file:
            pdf_reader = PyPDF2.PdfReader(file)
            total_pages = len(pdf_reader.pages)
    except:
        total_pages = 0
    
    # Page selection options
    st.markdown("---")
    
    st.markdown("### Page Selection & Preview")
    page_option = st.radio(
        "Choose pages to convert:",
        ["All Pages", "Page Range", "Specific Pages"],
        help="Select which pages you want to convert to audiobook"
    )
    
    start_page = 1
    end_page = total_pages if total_pages > 0 else None
    specific_pages = None
    
    if total_pages > 0:
        st.info(f"📖 This PDF has **{total_pages} pages**")
        
        if page_option == "Page Range":
            col1, col2 = st.columns(2)
            with col1:
                start_page = st.number_input(
                    "Start Page",
                    min_value=1,
                    max_value=total_pages,
                    value=1,
                    step=1,
                    key="start_page_input"
                )
            with col2:
                end_page = st.number_input(
                    "End Page",
                    min_value=start_page,
                    max_value=total_pages,
                    value=min(start_page + 4, total_pages),
                    step=1,
                    key="end_page_input"
                )
            st.success(f"✓ Will convert pages {start_page} to {end_page} ({end_page - start_page + 1} pages)")
            
            # PDF Preview for page range
            st.markdown("#### 👁️ Preview Selected Pages")
            show_preview = st.checkbox("Show page previews", value=False, help="Display thumbnail previews of selected pages")
            
            if show_preview:
                try:
                    from pdf2image import convert_from_path
                    from PIL import Image
                    
                    with st.spinner("Loading page previews..."):
                        # Convert selected pages to images (limit to first 100 for performance)
                        pages_to_show = min(end_page - start_page + 1, 100)
                        images = convert_from_path(
                            temp_pdf_path,
                            first_page=start_page,
                            last_page=min(start_page + pages_to_show - 1, end_page),
                            dpi=100,  # Lower DPI for faster loading
                            size=(300, None)  # Thumbnail size
                        )
                        
                        # Display images in grid
                        if pages_to_show > 5:
                            st.info(f"Showing first {pages_to_show} pages of your selection")
                        
                        # Create columns for grid layout (3 images per row)
                        cols_per_row = 3
                        for i in range(0, len(images), cols_per_row):
                            cols = st.columns(cols_per_row)
                            for j, col in enumerate(cols):
                                idx = i + j
                                if idx < len(images):
                                    with col:
                                        page_num = start_page + idx
                                        st.image(images[idx], caption=f"Page {page_num}", use_container_width=True)
                        
                        if end_page - start_page + 1 > 100:
                            st.warning(f"⚠️ Showing first 100 pages only. Your selection includes {end_page - start_page + 1} pages total.")
                
                except ImportError:
                    st.error("📦 PDF preview requires additional packages. Install with: `pip install pdf2image pillow`")
                    st.info("You can still convert without preview!")
                except Exception as e:
                    st.error(f"Could not load preview: {str(e)}")
                    st.info("This might happen if poppler is not installed. You can still convert without preview!")
        
        elif page_option == "Specific Pages":
            specific_pages_input = st.text_input(
                "Enter page numbers (comma-separated)",
                placeholder="e.g., 1,3,5,7-10,15",
                help="Enter individual pages (1,3,5) or ranges (7-10)"
            )
            
            if specific_pages_input:
                try:
                    # Parse page numbers
                    specific_pages = []
                    for part in specific_pages_input.split(','):
                        part = part.strip()
                        if '-' in part:
                            # Handle range like "7-10"
                            range_start, range_end = map(int, part.split('-'))
                            specific_pages.extend(range(range_start, range_end + 1))
                        else:
                            # Handle single page
                            specific_pages.append(int(part))
                    
                    # Remove duplicates and sort
                    specific_pages = sorted(set(specific_pages))
                    
                    # Validate pages
                    invalid_pages = [p for p in specific_pages if p < 1 or p > total_pages]
                    if invalid_pages:
                        st.error(f"❌ Invalid page numbers: {invalid_pages}")
                        specific_pages = None
                    else:
                        st.success(f"✓ Will convert {len(specific_pages)} pages: {specific_pages[:10]}{'...' if len(specific_pages) > 10 else ''}")
                        
                        # PDF Preview for specific pages
                        st.markdown("#### 👁️ Preview Selected Pages")
                        show_preview = st.checkbox("Show page previews", value=False, help="Display thumbnail previews of selected pages", key="specific_preview")
                        
                        if show_preview and specific_pages:
                            try:
                                from pdf2image import convert_from_path
                                from PIL import Image
                                
                                with st.spinner("Loading page previews..."):
                                    # Limit preview to first 100 pages
                                    pages_to_preview = specific_pages[:100]
                                    
                                    if len(specific_pages) > 100:
                                        st.info(f"Showing first 100 pages of your {len(specific_pages)} selected pages")
                                    
                                    # Convert specific pages to images
                                    images = []
                                    for page_num in pages_to_preview:
                                        page_images = convert_from_path(
                                            temp_pdf_path,
                                            first_page=page_num,
                                            last_page=page_num,
                                            dpi=100,
                                            size=(300, None)
                                        )
                                        if page_images:
                                            images.append((page_num, page_images[0]))
                                    
                                    # Display images in grid
                                    cols_per_row = 3
                                    for i in range(0, len(images), cols_per_row):
                                        cols = st.columns(cols_per_row)
                                        for j, col in enumerate(cols):
                                            idx = i + j
                                            if idx < len(images):
                                                with col:
                                                    page_num, img = images[idx]
                                                    st.image(img, caption=f"Page {page_num}", use_container_width=True)
                            
                            except ImportError:
                                st.error("📦 PDF preview requires additional packages. Install with: `pip install pdf2image pillow`")
                                st.info("You can still convert without preview!")
                            except Exception as e:
                                st.error(f"Could not load preview: {str(e)}")
                                st.info("This might happen if poppler is not installed. You can still convert without preview!")
                
                except ValueError:
                    st.error("❌ Invalid format. Use: 1,3,5 or 7-10")
                    specific_pages = None
    
    # Custom output filename
    st.markdown("---")
    st.markdown("### 💾 Output Settings")
    
    default_name = Path(uploaded_file.name).stem + "_audiobook"
    custom_filename = st.text_input(
        "Audiobook filename (without extension)",
        value=default_name,
        help="Enter a custom name for your audiobook file"
    )
    
    if not custom_filename:
        custom_filename = default_name
    
    # Clean filename (remove invalid characters)
    import re
    custom_filename = re.sub(r'[<>:"/\\|?*]', '_', custom_filename)
    
    st.info(f"📁 Output file will be saved as: **{custom_filename}.mp3**")
    
    # Convert button
    st.markdown("---")
    if st.button("🎵 Convert to Audiobook", key="convert_btn", type="primary"):
        
        # Create temporary directory for processing
        with tempfile.TemporaryDirectory() as temp_dir:
            # Save uploaded PDF to temp file
            pdf_path = os.path.join(temp_dir, uploaded_file.name)
            with open(pdf_path, 'wb') as f:
                f.write(uploaded_file.getbuffer())
            
            # Determine output path with custom filename
            extension = '.mp3'
            output_path = os.path.join(temp_dir, f"{custom_filename}{extension}")
            
            # Progress indicators
            st.markdown("---")
            st.markdown("### Converting...")
            
            progress_bar = st.progress(0)
            status_text = st.empty()
            
            try:
                # Update progress - extracting text
                progress_bar.progress(10)
                
                if page_option == "All Pages":
                    status_text.text("Extracting text from all pages...")
                elif page_option == "Page Range":
                    status_text.text(f"Extracting text from pages {start_page} to {end_page}...")
                else:
                    status_text.text(f"Extracting text from {len(specific_pages)} selected pages...")
                
                time.sleep(0.5)
                
                # Create converter instance
                converter = PDFToAudiobook(
                    pdf_path=pdf_path,
                    output_path=output_path,
                    engine=engine,
                    language=language,
                    voice=voice
                )
                
                # Extract text with page selection
                if page_option == "All Pages":
                    text = converter.extract_text_from_pdf()
                elif page_option == "Page Range":
                    text = converter.extract_text_from_pdf(start_page=start_page, end_page=end_page)
                else:  # Specific Pages
                    if specific_pages:
                        text = converter.extract_text_from_pdf(specific_pages=specific_pages)
                    else:
                        st.error("Please enter valid page numbers")
                        st.stop()
                
                if not text or len(text.strip()) == 0:
                    st.error("❌ No text content found in the PDF")
                    
                    if language == "bn":
                        st.warning("""
                        **সমস্যা সমাধান (Bengali PDF):**
                        
                        আপনার PDF এ টেক্সট পাওয়া যায়নি। সম্ভাব্য কারণ:
                        
                        1. **স্ক্যান করা ইমেজ**: PDF টি স্ক্যান করা ছবি হতে পারে (টেক্সট নয়)
                        2. **ফন্ট সমস্যা**: PDF এ Unicode Bengali ফন্ট ব্যবহার করা হয়নি
                        3. **লক করা PDF**: PDF টি পাসওয়ার্ড দিয়ে সুরক্ষিত
                        
                        **সমাধান:**
                        - নিশ্চিত করুন PDF এ সিলেক্ট করা যায় এমন বাংলা টেক্সট আছে
                        - স্ক্যান করা PDF হলে OCR সফটওয়্যার ব্যবহার করুন
                        - Unicode Bengali ফন্ট দিয়ে নতুন PDF তৈরি করুন
                        """)
                    else:
                        st.warning("""
                        **Troubleshooting:**
                        
                        No text was found in your PDF. Possible reasons:
                        
                        1. **Scanned Image**: PDF contains scanned images, not actual text
                        2. **Font Encoding**: PDF uses non-standard fonts or encoding
                        3. **Protected PDF**: PDF is password-protected or encrypted
                        
                        **Solutions:**
                        - Make sure PDF has selectable text (try selecting text manually)
                        - If scanned, use OCR software to convert images to text first
                        - Try re-creating the PDF with standard fonts
                        - Test with a different PDF to verify the app works
                        """)
                    
                    st.info("💡 **Tip**: Try opening the PDF and see if you can select/copy text. If not, it's likely a scanned image.")
                    st.stop()
                
                progress_bar.progress(30)
                status_text.text(f"Extracted {len(text)} characters")
                time.sleep(0.5)
                
                # Clean text
                progress_bar.progress(40)
                status_text.text("Cleaning and processing text...")
                cleaned_text = converter.clean_text_for_speech(text)
                time.sleep(0.5)
                
                # Convert to speech
                progress_bar.progress(50)
                if language == "bn":
                    status_text.text("বাংলায় অডিও তৈরি হচ্ছে... (এটি কিছু সময় নিতে পারে)")
                else:
                    status_text.text("Converting text to speech using Microsoft Edge TTS... (this may take a while)")
                
                # Perform conversion using Edge TTS
                success = converter.text_to_speech_edge(cleaned_text)
                
                progress_bar.progress(90)
                
                if success and os.path.exists(output_path):
                    progress_bar.progress(100)
                    status_text.text("Conversion completed successfully!")
                    
                    # Success message
                    st.markdown('<div class="success-box">', unsafe_allow_html=True)
                    if language == "bn":
                        st.markdown("### ✅ আপনার অডিওবুক তৈরি হয়ে গেছে!")
                    else:
                        st.markdown("### ✅ Your audiobook is ready!")
                    st.markdown('</div>', unsafe_allow_html=True)
                    
                    # File info
                    file_size = os.path.getsize(output_path)
                    
                    col1, col2 = st.columns(2)
                    with col1:
                        st.metric("Output File", f"{custom_filename}.mp3")
                    with col2:
                        st.metric("File Size", f"{file_size / 1024 / 1024:.2f} MB")
                    
                    if page_option != "All Pages":
                        if page_option == "Page Range":
                            st.info(f"📄 Converted pages {start_page} to {end_page}")
                        else:
                            st.info(f"📄 Converted {len(specific_pages)} selected pages")
                    
                    # Read the audio file
                    with open(output_path, 'rb') as audio_file:
                        audio_bytes = audio_file.read()
                    
                    # Audio player
                    st.markdown("### 🎧 Preview Audio")
                    st.audio(audio_bytes, format=f'audio/{extension[1:]}')
                    
                    # Download button with custom filename
                    st.markdown("### 💾 Download")
                    st.download_button(
                        label=f"⬇️ Download {custom_filename}.mp3",
                        data=audio_bytes,
                        file_name=f"{custom_filename}.mp3",
                        mime=f'audio/{extension[1:]}',
                        key="download_btn",
                        type="primary"
                    )
                    
                else:
                    st.error("Conversion failed. Please check your internet connection and try again.")
            
            except Exception as e:
                st.error(f"An error occurred: {str(e)}")
                st.exception(e)
    
    # Cleanup temp PDF file
    try:
        if temp_pdf_path and os.path.exists(temp_pdf_path):
            os.unlink(temp_pdf_path)
    except:
        pass
                
else:
    # Instructions when no file is uploaded
    st.markdown('<div class="info-box">', unsafe_allow_html=True)
    st.markdown("""
    ### 🚀 How to use:
    1. **Upload** a PDF file using the file uploader above
    2. **Select Language** - Choose English or Bengali (বাংলা) from sidebar
    3. **Choose Pages** - Convert all pages, a range, or specific pages
    4. **Name Your File** - Customize the output filename
    5. **Convert** - Click the "Convert to Audiobook" button
    6. **Preview & Download** - Listen and download your audiobook!
    
    ### ✨ New Features:
    - 🌐 **Bengali Language Support** - বাংলা PDF থেকে অডিওবুক তৈরি করুন
    - 📄 **Page Selection** - Convert specific pages or ranges (e.g., 1-10, 15, 20-25)
    - 💾 **Custom Naming** - Name your audiobook before downloading
    - 🎧 **Preview Audio** - Listen before downloading
    
    **Note:** Conversion time depends on:
    - Number of pages selected
    - PDF complexity and size
    - Internet connection speed (required for TTS)
    """)
    st.markdown('</div>', unsafe_allow_html=True)

# Footer
st.markdown("---")
st.markdown("""
    <div style='text-align: center; color: #888; padding: 20px;'>
        <p><b>Tips:</b> For best results, use PDFs with clear text content. Scanned PDFs may not work properly.</p>
        <p>Your files are processed securely and are not stored on our servers.</p>
    </div>
""", unsafe_allow_html=True)
